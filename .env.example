# ================================================================
#  环境变量配置模板
#
#  使用方法：
#    1. 复制此文件：cp .env.example .env
#    2. 修改 .env 中的值（不要提交 .env 到 Git）
# ================================================================

# ---- Flask ----
# 应用密钥（生产环境必须修改，本地开发可保持默认）
SECRET_KEY=subscription-dev-insecure-key

# 运行环境：development / production / testing
# 未设置时自动判断（有 TRIM_APPDEST → production，否则 → development）
# SUBSCRIPTION_ENV=development

# ---- 数据库 ----
# 数据库文件路径（默认 data/subscription.db）
# DB_PATH=./data/subscription.db

# ---- fnOS 网关（设备部署时由系统注入，本地无需设置） ----
# TRIM_APPDEST=
# TRIM_PKGVAR=
# TRIM_APPVER=
# TRIM_SYS_ARCH=
# GATEWAY_PREFIX=/app/subscription
