#!/bin/bash
# 安装完成后: 初始化数据目录与数据库 (幂等)
# 依赖已打进 app/backend/vendor，不再在设备上 pip install。
set -euo pipefail

if [ -n "${TRIM_PKGVAR:-}" ]; then
  mkdir -p "${TRIM_PKGVAR}/logs" "${TRIM_PKGVAR}/backups"
  exec >>"${TRIM_PKGVAR}/logs/install.log" 2>&1
else
  exec >>/tmp/subscription-install.log 2>&1
fi

echo "==== install_callback $(date 2>/dev/null || true) pid=$$ ===="
echo "TRIM_APPDEST=${TRIM_APPDEST:-}"
echo "TRIM_PKGVAR=${TRIM_PKGVAR:-}"
echo "TRIM_SYS_ARCH=${TRIM_SYS_ARCH:-}"
echo "wizard_reminder_days=${wizard_reminder_days:-}"

if [ -z "${TRIM_APPDEST:-}" ]; then
  echo "错误: TRIM_APPDEST 为空"
  exit 1
fi

# shellcheck source=/dev/null
. "${TRIM_APPDEST}/backend/vendor_env.sh"

if [ ! -x "${PYTHON_BIN}" ]; then
  echo "错误: Python 运行时不可用: ${PYTHON_BIN}（请先安装 python312 应用）"
  exit 1
fi

cd "${TRIM_APPDEST}/backend"

EXTRA_ARGS=()
if [ -n "${wizard_reminder_days:-}" ]; then
  EXTRA_ARGS+=(--reminder-days "${wizard_reminder_days}")
fi

echo "---- ${PYTHON_BIN} server.py --init-db ${EXTRA_ARGS[*]:-} ----"
"${PYTHON_BIN}" server.py --init-db "${EXTRA_ARGS[@]}"

# 放开必要的数据与日志目录读写权限，避免不同运行用户导致 sqlite3 readonly。
# 注意：不要使用 chmod -R 777 全量遍历（当 backups/logs 较多时会导致极慢的磁盘 IO 遍历）
if [ -n "${TRIM_PKGVAR:-}" ] && [ -d "${TRIM_PKGVAR}" ]; then
  chmod 777 "${TRIM_PKGVAR}" 2>/dev/null || true
  chmod 777 "${TRIM_PKGVAR}/logs" "${TRIM_PKGVAR}/backups" 2>/dev/null || true
  find "${TRIM_PKGVAR}" -maxdepth 1 -name "*.db*" -exec chmod 666 {} + 2>/dev/null || true
fi

echo "==== install_callback 完成 ===="
exit 0
